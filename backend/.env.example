# Copier en .env (git-ignoré).
DATABASE_URL=postgres://shreddish:shreddish@localhost:5433/shreddish
# Tests d'intégration : base dédiée (créée par docker-init/).
TEST_DATABASE_URL=postgres://shreddish:shreddish@localhost:5433/shreddish_test
BIND_ADDR=127.0.0.1:8080
RUST_LOG=shreddish_api=debug,tower_http=info
# Limites quotidiennes par type d'action IA (spec 022 FR-2204, valeurs de dev).
QUOTA_WEEK=3
QUOTA_MEAL=30
QUOTA_DAY=10
QUOTA_RECIPE=60
# Vérificateur d'achats : dev (preuve de test acceptée) ou none. Jamais dev en production.
ENTITLEMENT_VERIFIER=dev
APP_ENV=development
