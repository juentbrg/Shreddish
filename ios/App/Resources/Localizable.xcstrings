    "Privées : gardées sur ton iPhone, jamais envoyées à l'IA. Même lumière et même pose à chaque fois.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Privat: bleiben auf deinem iPhone, nie an die KI gesendet. Jedes Mal gleiches Licht und gleiche Pose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private: kept on your iPhone, never sent to the AI. Same light and pose every time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privadas: se guardan en tu iPhone, nunca se envían a la IA. Misma luz y misma pose cada vez."
          }
        },
