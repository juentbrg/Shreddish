    "Rythme rapide : plus de 1 % du poids par semaine. Risque de perte musculaire, pense à remonter un peu les calories.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelles Tempo: mehr als 1 % des Gewichts pro Woche. Risiko von Muskelverlust, erhöhe die Kalorien etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast pace: more than 1% of body weight per week. Risk of muscle loss, consider raising calories a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo rápido: más del 1 % del peso por semana. Riesgo de perder músculo, plantéate subir un poco las calorías."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritmo veloce: oltre l'1% del peso a settimana. Rischio di perdere muscolo, valuta di alzare un po' le calorie."
          }
        }
      }
    },
