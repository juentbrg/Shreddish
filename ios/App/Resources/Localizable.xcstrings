        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se volverá a proponer en tus planes. %lld comidas próximas lo contienen: cámbialas con «Otra idea de comida»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sarà mai più proposto. %lld pasti in arrivo lo contengono: sostituiscili con «Un'altra idea»."
          }
        }
      }
    },
