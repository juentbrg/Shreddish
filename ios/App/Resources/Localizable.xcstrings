          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without consent, the app works except for generating menus and recipes. You can withdraw it in Settings → Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin consentimiento, la app funciona salvo la generación de menús y recetas. Puedes retirarlo en Ajustes → Privacidad."
          }
        },
        "it": {
