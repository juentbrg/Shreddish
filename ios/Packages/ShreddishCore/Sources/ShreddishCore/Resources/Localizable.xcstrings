    "Quota OpenAI atteint ou trop de requêtes. Réessaie plus tard ou vérifie ton crédit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-Kontingent erreicht oder zu viele Anfragen. Versuch es später oder prüf dein Guthaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI quota reached or too many requests. Try again later or check your credit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuota de OpenAI alcanzada o demasiadas solicitudes. Inténtalo más tarde o revisa tu crédito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota OpenAI raggiunta o troppe richieste. Riprova più tardi o controlla il credito."
          }
        }
      }
    },
