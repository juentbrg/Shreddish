    "Au réveil, à jeun, pour suivre ton rythme.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Aufstehen, nüchtern, um dein Tempo zu verfolgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you wake up, before eating, to track your pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al despertar, en ayunas, para seguir tu ritmo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al risveglio, a digiuno, per seguire il tuo ritmo."
          }
        }
      }
    },
    "Batch cooking aujourd'hui": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Meal Prep"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch cooking today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch cooking hoy"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch cooking oggi"
          }
        }
      }
    },
    "Clé API absente du build : renseigne OPENAI_API_KEY dans Config/Secrets.xcconfig.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel fehlt im Build: OPENAI_API_KEY in Config/Secrets.xcconfig setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key missing from the build: set OPENAI_API_KEY in Config/Secrets.xcconfig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la clave API en la compilación: define OPENAI_API_KEY en Config/Secrets.xcconfig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API assente nella build: imposta OPENAI_API_KEY in Config/Secrets.xcconfig."
          }
        }
      }
    },
    "Clé API refusée par OpenAI : remplace-la dans Config/Secrets.xcconfig.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel von OpenAI abgelehnt: ersetze ihn in Config/Secrets.xcconfig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API key rejected by OpenAI: replace it in Config/Secrets.xcconfig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave API rechazada por OpenAI: cámbiala en Config/Secrets.xcconfig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API rifiutata da OpenAI: sostituiscila in Config/Secrets.xcconfig."
          }
        }
      }
    },
