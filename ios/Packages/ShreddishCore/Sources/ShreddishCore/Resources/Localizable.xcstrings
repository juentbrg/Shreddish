        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Your current plan is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Tu plan actual sigue disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione internet. Il tuo piano attuale resta disponibile."
          }
        }
      }
    },
