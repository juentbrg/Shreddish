    "L'IA a renvoyé un planning invalide. Réessaie.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat einen ungültigen Plan geliefert. Versuch es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI returned an invalid plan. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA devolvió un plan no válido. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA ha restituito un piano non valido. Riprova."
          }
        }
      }
    },
    "OpenAI est indisponible (erreur %lld). Réessaie dans un instant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI ist nicht erreichbar (Fehler %lld). Versuch es gleich noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI is unavailable (error %lld). Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI no está disponible (error %lld). Inténtalo en un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI non è disponibile (errore %lld). Riprova tra un attimo."
          }
        }
      }
    },
    "OpenAI met trop de temps à répondre. Réessaie dans un instant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI braucht zu lange. Versuch es gleich noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI is taking too long to respond. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI tarda demasiado en responder. Inténtalo en un momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI impiega troppo a rispondere. Riprova tra un attimo."
          }
        }
      }
    },
    "Pas de connexion internet. Ton planning actuel reste disponible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Dein aktueller Plan bleibt verfügbar."
