    "Planifie la suite pour garder le rythme.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane weiter, um dranzubleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan what's next to keep your momentum."
          }
        },
