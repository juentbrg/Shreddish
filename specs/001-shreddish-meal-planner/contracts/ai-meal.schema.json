{
  "$comment": "Schémas JSON pour OpenAI Responses API, text.format json_schema strict. Strict mode : tous les champs required, additionalProperties false, nullable via type [x, null].",
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "quantity", "unit", "aisle", "cost_eur"],
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "enum": ["g", "ml", "piece"] },
        "aisle": {
          "type": "string",
          "enum": ["fruits_legumes", "viande_poisson", "cremerie", "epicerie", "surgeles", "boulangerie", "autre"]
        },
        "cost_eur": { "type": "number" }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "ingredients", "steps", "prep_minutes", "cost_eur", "kcal", "protein_g", "carbs_g", "fat_g", "prep_session_ref"],
      "properties": {
        "type": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
        "name": { "type": "string" },
        "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "prep_minutes": { "type": "integer" },
        "cost_eur": { "type": "number" },
        "kcal": { "type": "number" },
        "protein_g": { "type": "number" },
        "carbs_g": { "type": "number" },
        "fat_g": { "type": "number" },
        "prep_session_ref": { "type": ["integer", "null"] }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_offset", "meals"],
      "properties": {
        "day_offset": { "type": "integer" },
        "meals": { "type": "array", "items": { "$ref": "#/$defs/meal" } }
      }
    },
    "prep_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "day_offset", "title", "duration_minutes", "steps"],
      "properties": {
        "index": { "type": "integer" },
        "day_offset": { "type": "integer" },
        "title": { "type": "string" },
        "duration_minutes": { "type": "integer" },
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "infeasible": {
      "type": ["string", "null"],
      "description": "Non null si contraintes impossibles à respecter : raison en français. Dans ce cas, days peut être vide."
    }
  },

  "WeekPlanResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["infeasible", "prep_sessions", "days"],
    "properties": {
      "infeasible": { "$ref": "#/$defs/infeasible" },
      "prep_sessions": { "type": "array", "items": { "$ref": "#/$defs/prep_session" } },
      "days": { "type": "array", "items": { "$ref": "#/$defs/day" } }
    }
  },

  "DayPlanResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["infeasible", "day"],
    "properties": {
      "infeasible": { "$ref": "#/$defs/infeasible" },
      "day": { "$ref": "#/$defs/day" }
    }
  },

  "MealReplacementResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["infeasible", "meal"],
    "properties": {
      "infeasible": { "$ref": "#/$defs/infeasible" },
      "meal": { "$ref": "#/$defs/meal" }
    }
  }
}
